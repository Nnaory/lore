# LORE environment variables
#
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys, and never prefix a
# secret with NEXT_PUBLIC_ (that would send it to the browser).

# AI provider for the story pipeline. Only "google" (Gemini) exists, and it
# needs GOOGLE_API_KEY below. There is no offline or demo provider: without a
# key, building a story stops with a "the AI storyteller isn't set up" warning.
AI_PROVIDER=google

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# GEMINI_API_KEY is accepted as an alternative name.
GOOGLE_API_KEY=

# Gemini models, tried in order: when one is overloaded or retired, the next
# one is used. Put the model you prefer first.
AI_MODEL=gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.8-flash

# Per-request timeout, and the total time budget for one AI step across all
# models (milliseconds).
AI_TIMEOUT_MS=300000
AI_DEADLINE_MS=300000

# Where saved stories live. Read at build time (NEXT_PUBLIC_, inlined into
# the browser bundle), so changing it needs a new build:
#   idb  — this browser only, IndexedDB (default)
#   http — the LORE API (/api/v1/projects), with IndexedDB as a local cache
NEXT_PUBLIC_PROJECT_STORE=idb
