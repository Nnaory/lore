# LORE web environment variables
#
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys, and never prefix a
# secret with NEXT_PUBLIC_ (that would send it to the browser).
#
# The web app holds no AI key and calls no AI provider. Story generation is
# served by the LORE API (/api/v1/ai/*); its Gemini settings (AI_PROVIDER,
# GOOGLE_API_KEY, AI_MODEL, AI_TIMEOUT_MS, AI_DEADLINE_MS) belong in the
# backend environment, not here.

# Where saved stories live. Read at build time (NEXT_PUBLIC_, inlined into
# the browser bundle), so changing it needs a new build:
#   idb  — this browser only, IndexedDB (default)
#   http — the LORE API (/api/v1/projects), with IndexedDB as a local cache
NEXT_PUBLIC_PROJECT_STORE=idb

# `npm run dev` proxies /api/v1/* to the backend, as Caddy does in production.
# LORE_API_ORIGIN=http://localhost:8000
