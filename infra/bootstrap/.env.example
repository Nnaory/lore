# Optional: AWS CLI profile with admin permissions (uses active profile if unset)
# AWS_PROFILE=lore-admin

# Optional overrides (shown with defaults)
AWS_REGION=ap-southeast-3
GITHUB_REPO=Nnaory/lore
BUDGET_USD=70
ALLOW_NAT_GATEWAY=false
