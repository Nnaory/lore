# Required: email address for AWS Budgets and Cost Anomaly Detection alerts
ALERT_EMAIL=you@example.com

# Optional: AWS CLI profile with admin permissions (uses active profile if unset)
# AWS_PROFILE=lore-admin

# Optional overrides (shown with defaults)
AWS_REGION=ap-southeast-3
GITHUB_REPO=Nnaory/lore
# Auto-resolved from GitHub API as owner@owner_id/repo@repo_id if unset:
# GITHUB_OIDC_REPO=Nnaory@190932560/lore@1450338553
BUDGET_USD=70
ALLOW_NAT_GATEWAY=false
