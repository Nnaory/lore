{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AttachDetachDenyNewSpendOnly",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/lore-gh-apply",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::<ACCOUNT_ID>:policy/lore-deny-new-spend"
        }
      }
    }
  ]
}
