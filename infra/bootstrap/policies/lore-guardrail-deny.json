{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonMicroInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotEquals": {
          "ec2:InstanceType": "t3.micro"
        }
      }
    },
    {
      "Sid": "DenyBigVolumes",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "ec2:ModifyVolume"
      ],
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": {
        "NumericGreaterThan": {
          "ec2:VolumeSize": "30"
        }
      }
    },
    {
      "Sid": "DenyRdsOtherClasses",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "rds:RestoreDBInstanceFromDBSnapshot",
        "rds:RestoreDBInstanceToPointInTime"
      ],
      "Resource": "arn:aws:rds:*:*:db:*",
      "Condition": {
        "StringNotEquals": {
          "rds:DatabaseClass": "db.t3.micro"
        }
      }
    },
    {
      "Sid": "DenyRdsModifyOtherClass",
      "Effect": "Deny",
      "Action": "rds:ModifyDBInstance",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "rds:DatabaseClass": "db.t3.micro"
        },
        "Null": {
          "rds:DatabaseClass": "false"
        }
      }
    },
    {
      "Sid": "DenyRdsMultiAz",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:RestoreDBInstanceFromDBSnapshot",
        "rds:RestoreDBInstanceToPointInTime"
      ],
      "Resource": "*",
      "Condition": {
        "Bool": {
          "rds:MultiAz": "true"
        }
      }
    },
    {
      "Sid": "DenyRdsBigStorage",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:RestoreDBInstanceFromDBSnapshot",
        "rds:RestoreDBInstanceToPointInTime"
      ],
      "Resource": "*",
      "Condition": {
        "NumericGreaterThan": {
          "rds:StorageSize": "50"
        }
      }
    },
    {
      "Sid": "DenyRdsPiops",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:RestoreDBInstanceFromDBSnapshot",
        "rds:RestoreDBInstanceToPointInTime"
      ],
      "Resource": "*",
      "Condition": {
        "NumericGreaterThan": {
          "rds:Piops": "0"
        }
      }
    },
    {
      "Sid": "DenyNatGateway",
      "Effect": "Deny",
      "Action": "ec2:CreateNatGateway",
      "Resource": "*"
    },
    {
      "Sid": "DenyLoadBalancers",
      "Effect": "Deny",
      "Action": "elasticloadbalancing:CreateLoadBalancer",
      "Resource": "*"
    },
    {
      "Sid": "DenyNonS3VpcEndpoints",
      "Effect": "Deny",
      "Action": "ec2:CreateVpcEndpoint",
      "Resource": "arn:aws:ec2:*:*:vpc-endpoint/*",
      "Condition": {
        "StringNotEquals": {
          "ec2:VpceServiceName": "com.amazonaws.<AWS_REGION>.s3"
        }
      }
    },
    {
      "Sid": "DenyExpensiveServices",
      "Effect": "Deny",
      "Action": [
        "elasticache:*",
        "es:*",
        "wafv2:*",
        "cloudfront:*",
        "config:*",
        "guardduty:*",
        "inspector2:*",
        "macie2:*",
        "kms:CreateKey",
        "route53:CreateHostedZone",
        "rds:CreateDBCluster",
        "rds:CreateDBProxy",
        "logs:CreateLogGroup"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProtectGovernance",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/lore-gh-*",
        "arn:aws:iam::<ACCOUNT_ID>:role/lore-budgets-action",
        "arn:aws:iam::<ACCOUNT_ID>:policy/lore-guardrail*",
        "arn:aws:iam::<ACCOUNT_ID>:policy/lore-deny-new-spend",
        "arn:aws:iam::<ACCOUNT_ID>:oidc-provider/token.actions.githubusercontent.com"
      ]
    },
    {
      "Sid": "ProtectBudgetsAndCostExplorer",
      "Effect": "Deny",
      "Action": [
        "budgets:*",
        "ce:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoIamUsersOrKeys",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:AttachUserPolicy",
        "iam:PutUserPolicy"
      ],
      "Resource": "*"
    }
  ]
}
