{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNewSpend",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "ec2:AllocateAddress",
        "ec2:CreateNatGateway",
        "rds:Create*"
      ],
      "Resource": "*"
    }
  ]
}
