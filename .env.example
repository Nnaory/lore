# LORE environment variables
#
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys, and never prefix a
# secret with NEXT_PUBLIC_ (that would send it to the browser).

# AI provider for the story pipeline:
#   google — Gemini (needs GOOGLE_API_KEY)
#   dummy  — offline deterministic templates, no key needed (default)
AI_PROVIDER=dummy

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# GEMINI_API_KEY is accepted as an alternative name.
GOOGLE_API_KEY=

# Gemini models, tried in order: when one is overloaded or retired, the next
# one is used. Put the model you prefer first.
AI_MODEL=gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.8-flash

# Per-request timeout, and the total time budget for one AI step across all
# models (milliseconds).
AI_TIMEOUT_MS=30000
AI_DEADLINE_MS=90000
